# ==============================================================================
# Environment Configuration Template for Bookworm Backend Platform
# Copy to .env and customize secrets before production deployment
# ==============================================================================

# Database Configuration
POSTGRES_DB=bookworm
POSTGRES_USER=bookworm
POSTGRES_PASSWORD=bookworm_secret
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/bookworm

# Security & JWT Configuration (Must be >= 256 bits for HMAC-SHA256)
JWT_SECRET=bookwormEnterpriseSecretKeyMustBeAtLeast256BitsLongForHMACSHA256!
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Payment Gateway Webhook Secret
PAYMENT_WEBHOOK_SECRET=whsec_bookworm_enterprise_mock_key_2025

# Server Port
SERVER_PORT=8080
